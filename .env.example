MYSQL_DATABASE=time_keeping_app
MYSQL_USER=root
MYSQL_PASSWORD=local-dev-root
MYSQL_ROOT_PASSWORD=local-dev-root
JWT_SECRET=local-only-change-this-secret

# Firebase Authentication (Google provider must be enabled in the Firebase console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# SMTP settings for TinyTalkers registration-success emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=